{
  "manifest_version": 3,
  "name": "Vibe Radar X Taslakları",
  "version": "1.1.0",
  "description": "X gönderileri için Tweetin dilinde veya seçilen dilde AI yanıt ve alıntı taslağı hazırlar.",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://borsa.discilaw.com/*",
    "https://heranborsa.av-fatihdisci.workers.dev/*"
  ],
  "background": {"service_worker": "background.js"},
  "options_ui": {"page": "options.html"},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["helpers.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["styles.css"],
    "matches": ["https://x.com/*", "https://twitter.com/*"]
  }]
}
